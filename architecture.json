{
  "version": 1,
  "perspectives": [
    {
      "name": "Layers",
      "groups": [
        {
          "name": "App",
          "patterns": ["app/**/*"]
        },
        {
          "name": "Modules",
          "patterns": ["modules/**/*"]
        },
        {
          "name": "Infrastructure",
          "patterns": ["infrastructure/**/*"]
        },
        {
          "name": "Events",
          "patterns": ["events/**/*"]
        },
        {
          "name": "Config",
          "patterns": ["config/**/*"]
        }
      ]
    }
  ],
  "constraints": [
    {
      "name": "Infrastructure isolation",
      "from": "Infrastructure",
      "to": "Modules",
      "action": "forbid"
    },
    {
      "name": "Events isolation",
      "from": "Events",
      "to": "Modules",
      "action": "forbid"
    },
    {
      "name": "Config isolation",
      "from": "Config",
      "to": "Modules",
      "action": "forbid"
    },
    {
      "name": "Internal module isolation",
      "from": "Modules",
      "to": "Modules",
      "action": "forbid"
    }
  ]
}
